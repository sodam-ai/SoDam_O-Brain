{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "node --env-file-if-exists=\"${CLAUDE_PLUGIN_ROOT}/../app/.env.local\" ${CLAUDE_PLUGIN_ROOT}/scripts/memory-inject-hook.mjs" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "node --env-file-if-exists=\"${CLAUDE_PLUGIN_ROOT}/../app/.env.local\" ${CLAUDE_PLUGIN_ROOT}/scripts/memory-extract-hook.mjs", "async": true }
        ]
      }
    ]
  }
}
